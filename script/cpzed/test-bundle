#!/usr/bin/env bash
# Tests for script/cpzed/{bundle,selfcheck} that need no build. Exit 0 = all pass.
set -uo pipefail
here=$(cd "$(dirname "$0")" && pwd)
T=$(mktemp -d); trap 'rm -rf "$T"' EXIT
fails=0
t() { local name=$1 want=$2; shift 2; "$@" >/dev/null 2>&1; local rc=$?
  if { [[ $want == ok && $rc -eq 0 ]] || [[ $want == fail && $rc -ne 0 ]]; }; then echo "pass: $name"; else echo "FAIL: $name (rc=$rc)"; fails=1; fi; }

tgt=$T/target; mkdir -p "$tgt/inside"
ln -s /Applications "$tgt/link-apps"; ln -s "$HOME" "$tgt/link-home"
# check-out: allowlist (inside repo root, out inside target) + case-insensitive denylist.
# Fake HOME and fake repo root; the real /Applications is only ever a *string* here.
FH=$T/home; root=$FH/code/cpzed-sandbox/wt; tgt=$root/target-install
mkdir -p "$tgt/inside" "$FH/Library/Application Support/CPZed" "$FH/code/cpzed-sandbox/zed.git"
ln -s /Applications "$tgt/link-apps"; ln -s "$FH" "$tgt/link-home"
mkdir -p "$root/script/cpzed" "$FH/code/cpzed-sandbox/wt/untracked-work"; touch "$tgt/.metadata_never_index"
echo x > "$root/script/cpzed/tracked.sh"; echo y > "$root/untracked-work-file"
git -C "$root" init -q && git -C "$root" add script && git -C "$root" -c user.name=t -c user.email=t@t commit -qm init
co() { HOME=$FH "$here/bundle" check-out "$@"; }
t "out inside target ok"             ok   co "$tgt/inside/o" "$tgt" "$root"
t "default-style out ok"             ok   co "$tgt/cpzed-out" "$tgt" "$root"
t "out == /Applications/CPZed.app"   fail co /Applications/CPZed.app "$tgt" "$root"
t "lowercase /applications target"   fail co /applications/CPZed.app /applications /
t "mixed-case /ApplicationS target"  fail co /ApplicationS/x/CPZed.app /ApplicationS/x /
t "lowercase /users/<u> home check"  fail env HOME=/Users/zz "$here/bundle" check-out /users/zz/foo /users/zz /
t "out == HOME"                      fail co "$FH" "$tgt" "$root"
t "out == child of HOME"             fail co "$FH/code" "$tgt" "$root"
t "target == fake Application Support" fail co "$FH/Library/Application Support/Zed" "$FH/Library/Application Support" "$root"
t "target == fake App Support, root widened" fail co "$FH/Library/Application Support/Zed" "$FH/Library/Application Support" "$FH"
t "target == dir holding zed.git"    fail co "$FH/code/cpzed-sandbox/zed.git" "$FH/code/cpzed-sandbox" "$root"
t "out == CPZed state dir"           fail co "$FH/Library/Application Support/CPZed/ring" "$tgt" "$root"
t "relative out"                     fail co relative/dir "$tgt" "$root"
t ".. escape"                        fail co "$tgt/inside/../../escape" "$tgt" "$root"
t "symlink to /Applications"         fail co "$tgt/link-apps/CPZed.app" "$tgt" "$root"
t "symlink to HOME"                  fail co "$tgt/link-home/x" "$tgt" "$root"
t "out == target itself"             fail co "$tgt" "$tgt" "$root"
t "target == repo root itself"       fail co "$root/x" "$root" "$root"
t "target outside repo root"         fail co "$T/elsewhere/o" "$T/elsewhere" "$root"
t "N1 target == repo/script (tracked)"  fail co "$root/script/cpzed" "$root/script" "$root"
t "N1 out == repo/script/cpzed (tracked)" fail co "$root/script/cpzed" "$tgt" "$root"
mkdir -p "$tgt/work"; echo u > "$tgt/work/untracked.txt"
t "N1 out with untracked file, no marker" fail co "$tgt/work" "$tgt" "$root"
mkdir -p "$root/plain"; echo u > "$root/plain/untracked.txt"
t "N1 target with untracked work, no marker" fail co "$root/plain/o" "$root/plain" "$root"
mkdir -p "$tgt/prev"; touch "$tgt/prev/.cpzed-bundle-out" "$tgt/prev/file"
t "out with our marker is ok"           ok   co "$tgt/prev" "$tgt" "$root"
got=$(HOME=$FH "$here/bundle" check-out "$tgt/inside/../inside/o" "$tgt" "$root" 2>/dev/null); want=$(python3 -I -c 'import os,sys;print(os.path.realpath(sys.argv[1]))' "$tgt/inside/o")
t "N2 returns the resolved path (not the caller spelling)" ok test "$got" = "$want"
t "--skip-build without env guard"  fail "$here/bundle" --skip-build --dry-run

sha=0123456789abcdef0123456789abcdef01234567
printf 'binary %s end' "$sha" > "$T/fresh"; printf 'binary othersha end' > "$T/stale"
t "binary embedding sha ok"         ok   "$here/bundle" verify-sha "$T/fresh" "$sha"
t "stale binary rejected"           fail "$here/bundle" verify-sha "$T/stale" "$sha"

# selfcheck: doctored source, LSEnvironment mismatch, missing icns
repo=$(cd "$here/../.." && pwd)
t "selfcheck source real"           ok   "$here/selfcheck" source
sed 's/option_env!("ZED_UPDATE_EXPLANATION").is_none()/true/' "$repo/crates/auto_update/src/auto_update.rs" > "$T/doctored.rs"
t "selfcheck doctored source"       fail "$here/selfcheck" source --file "$T/doctored.rs"
app=$T/CPZed.app; mkdir -p "$app/Contents/MacOS" "$app/Contents/Resources"
cat > "$app/Contents/Info.plist" <<'P'
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0"><dict><key>CFBundleIdentifier</key><string>x</string>
<key>CFBundleURLTypes</key><array><dict><key>CFBundleURLSchemes</key><array><string>zed</string></array></dict></array></dict></plist>
P
"$here/bundle" patch-plist "$app" 1.31.0 $sha 12
printf 'xx%sxx' "$("$here/selfcheck" explanation)" > "$app/Contents/MacOS/zed"
echo "{\"sha\":\"$sha\",\"n\":12,\"upstream_base\":\"x\",\"built_at\":\"t\",\"host\":\"h\"}" > "$app/Contents/Resources/cpzed-build.json"
echo icns > "$app/Contents/Resources/Zed.icns"
t "selfcheck app missing Document.icns" fail "$here/selfcheck" app "$app"
echo icns > "$app/Contents/Resources/Document.icns"
t "selfcheck app good"              ok   "$here/selfcheck" app "$app"
/usr/libexec/PlistBuddy -c 'Set :LSEnvironment:ZED_UPDATE_EXPLANATION "something else"' "$app/Contents/Info.plist"
t "selfcheck LSEnvironment differs" fail "$here/selfcheck" app "$app"
exit $fails
