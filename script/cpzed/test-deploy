EOF
  chmod +x "$E/bin/quit2"; export CPZED_QUIT_CMD="$E/bin/quit2"; start_app "$E/apps/CPZed.app"; sre_on; dep run; sre_off
  ck quit-race-aborts "$RC" 30; ck quit-race-hold "$([[ -e $E/home/hold ]] && echo y)" y; ckm quit-race-notified "$(notes)" "still running from"
  ck quit-race-installed-untouched "$(sha_of "$E/apps/CPZed.app")" "$PREV_SHA"; kill_dummy
