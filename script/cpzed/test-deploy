  out=$(python3 -I "$D/deploy-util" eligible "$E/repo" "$E/ledger.json" "$E/bin/gh" --quiet-s 0); ckm first-deploy-blocked-by-unapproved-middle "$out" "blocked by"; ck first-deploy-not-shipped "$([[ "$out" == "$COMMIT" ]] && echo shipped || echo no)" no
  out=$(python3 -I "$D/deploy-util" eligible "$E/repo" "$E/ledger.json" "$E/bin/gh" --quiet-s 0 --upstream refs/nope/missing); ckm first-deploy-needs-upstream-ref "$out" "cannot list the fork-only commits"
  newenv fok; mkpr 1; mkpr 2; out=$(python3 -I "$D/deploy-util" eligible "$E/repo" "$E/ledger.json" "$E/bin/gh" --quiet-s 0); ck first-deploy-all-approved-ok "$out" "$COMMIT"
