sc_ditto_wait() { # marker-driven: the archiver blocks on a marker; NO quit while it runs; quit only after it exited
  newenv ditto; install_prev; mkpr 1
  local d dp; d=$(fake_tool ditto "while [ ! -e $E/archiver.release ]; do sleep 0.2; done; date +%s > $E/ditto.end")
  start_app "$E/apps/CPZed.app"; sre_on
  ( "$d" -c -k --keepParent "$E/apps/CPZed.app" "$E/out.zip" >/dev/null 2>&1 & ); poll 20 pgrep -f "$E/fake/ditto/ditto"
  CPZED_DITTO_WAIT_S=120 "$D/deploy" run >"$E/dep.out" 2>&1 & dp=$!
  poll 90 grep -q '\[restarting\]' "$E/notify.log"
  sleep 8                                  # an unguarded deploy quits within ~2 s of this notice
  ck ditto-no-quit-while-archiver-runs "$([[ -e $E/quit.log ]] && echo quit || echo none)" none
  touch "$E/archiver.release"; wait "$dp"; local rc=$?; sre_off
  ck ditto-deploy-ok "$rc" 0
  local q end launched; q=$(head -1 "$E/quit.log" 2>/dev/null); end=$(cat "$E/ditto.end" 2>/dev/null); launched=$(tail -1 "$E/open.log" | cut -d' ' -f1)
  ck ditto-quit-and-launch-after-archiver-exit "$([[ -n "$end" && -n "$q" && "$q" -ge "$end" && "$launched" -ge "$end" ]] && echo y)" y; kill_dummy
}

sc_first_swap() {
  # confirm path: stock quit, pause, user removes stock + confirms, then install + health
  newenv fsok; mkstock; mkpr 1; mkdir -p "$E/shim"; printf '#!/bin/sh\necho "$@" >> "%s/sudo.log"\nexit 1\n' "$E" > "$E/shim/sudo"; chmod +x "$E/shim/sudo"
  mkapp "$E/apps/Zed.app" 0 "$(printf '%040d' 77)" "$E/stock-build.json"; start_app "$E/apps/Zed.app"; sre_on
  ( for _ in $(seq 1 150); do grep -q '\[first-swap\]' "$E/notify.log" 2>/dev/null && break; sleep 0.2; done
    echo "$([[ -z "$(port_up)" && -d $E/apps/Zed.app && ! -d $E/apps/CPZed.app ]] && echo y)" > "$E/paused"
    rm -rf "$E/apps/Zed.app"; touch "$E/home/first-swap-confirm" ) &
  PATH="$E/shim:$PATH" dep run --first-swap; sre_off
  ck firstswap-paused-with-stock-quit "$(cat "$E/paused")" y
  ck firstswap-rc "$RC" 0; ck firstswap-installed "$(sha_of "$E/apps/CPZed.app")" "$COMMIT"
  ckm firstswap-prints-sudo-rm "$OUT" "sudo rm -rf \"$E/apps/Zed.app\""
  ckm firstswap-notes-sudo-ln "$(notes)" "sudo ln -sfn"
  ck firstswap-never-ran-sudo "$([[ -e $E/sudo.log ]] && echo ran || echo never)" never
  ck firstswap-marker-consumed "$([[ -e $E/home/first-swap-confirm ]] && echo left || echo gone)" gone; kill_dummy
  # timeout: no confirm => hold + notify, stock relaunched, nothing installed
  newenv fsto; mkstock; mkpr 1; mkapp "$E/apps/Zed.app" 0 "$(printf '%040d' 77)" "$E/stock-build.json"; start_app "$E/apps/Zed.app"; sre_on
  dep run --first-swap; sre_off
  ck firstswap-timeout-rc "$RC" 30; ck firstswap-timeout-hold "$([[ -e $E/home/hold ]] && echo y)" y
  ck firstswap-timeout-nothing-installed "$([[ -e $E/apps/CPZed.app ]] && echo y || echo n)" n
  ck firstswap-timeout-stock-relaunched "$(port_up | wc -l | tr -d ' ')" 1; kill_dummy
  # confirm marker but stock still present => abort
  newenv fsstill; mkstock; mkpr 1; mkapp "$E/apps/Zed.app" 0 "$(printf '%040d' 77)" "$E/stock-build.json"; start_app "$E/apps/Zed.app"; sre_on
  ( for _ in $(seq 1 150); do grep -q '\[first-swap\]' "$E/notify.log" 2>/dev/null && break; sleep 0.2; done
    touch "$E/home/first-swap-confirm" ) & dep run --first-swap; sre_off
  ck firstswap-stock-still-present-aborts "$RC" 30; ck firstswap-stock-present-hold "$([[ -e $E/home/hold ]] && echo y)" y
  ck firstswap-stock-present-nothing-installed "$([[ -e $E/apps/CPZed.app ]] && echo y || echo n)" n; kill_dummy
  # stock removed but the user never confirmed: must NOT proceed (the marker is the user's go)
  newenv fsnomark; mkstock; mkpr 1; mkapp "$E/apps/Zed.app" 0 "$(printf '%040d' 77)" "$E/stock-build.json"; start_app "$E/apps/Zed.app"; sre_on
  ( for _ in $(seq 1 150); do grep -q '\[first-swap\]' "$E/notify.log" 2>/dev/null && break; sleep 0.2; done; rm -rf "$E/apps/Zed.app" ) & CPZED_FIRST_SWAP_WAIT_S=8 dep run --first-swap; sre_off
  ck firstswap-no-marker-aborts "$RC" 30; ck firstswap-no-marker-nothing-installed "$([[ -e $E/apps/CPZed.app ]] && echo y || echo n)" n; kill_dummy
  # --first-swap refuses when CPZed.app already exists; plain deploy refuses when it is missing
  newenv fsex; install_prev; mkpr 1; dep run --first-swap; ck firstswap-refuses-existing "$RC" 30; ckm firstswap-refuses-existing-msg "$OUT" "already exists"; ck firstswap-refuses-existing-built-nothing "$(cat "$E/bundle.log" 2>/dev/null | wc -l | tr -d ' ')" 0
  newenv fsmiss; mkpr 1; dep run; ck deploy-refuses-missing-app "$RC" 30
}

sc_confinement() {
