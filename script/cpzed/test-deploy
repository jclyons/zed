sc_signal_after_quit() { # TERM after the quit must never leave the editor down silently
  local dp
  # A: during the post-quit window (a Glider archiver is running)
  newenv sigA; install_prev; mkpr 1; local d; d=$(fake_tool ditto "sleep 12")
  cat > "$E/bin/quit3" <<EOF
#!/bin/sh
echo "\$(date +%s)" >> "\$CPZED_TEST_PREFIX/quit.log"
pid=\$(cat "\$DUMMY_PID_FILE" 2>/dev/null); [ -n "\$pid" ] && kill -TERM "\$pid"
( "$d" -c -k --keepParent "\$CPZED_TEST_PREFIX/apps/CPZed.app" x.zip >/dev/null 2>&1 & )
exit 0
EOF
  chmod +x "$E/bin/quit3"; export CPZED_QUIT_CMD="$E/bin/quit3"; start_app "$E/apps/CPZed.app"; sre_on
  "$D/deploy" run >"$E/sig.out" 2>&1 & dp=$!
  poll 90 test -e "$E/quit.log"; sleep 1.5; kill -TERM "$dp"; wait "$dp"; local rc=$?; sre_off
  ck signal-after-quit-exit "$rc" 143; poll 20 test -n "$(port_up)"; ck signal-after-quit-old-app-relaunched "$(port_up | wc -l | tr -d ' ')" 1
  ck signal-after-quit-hold "$([[ -e $E/home/hold ]] && echo y)" y; ckm signal-after-quit-urgent "$(notes)" "interrupted in phase"
  ck signal-after-quit-installed-untouched "$(sha_of "$E/apps/CPZed.app")" "$PREV_SHA"; kill_dummy
  # B: during the first-swap wait for the user (stock quit): stock is relaunched
  newenv sigB; mkstock; mkpr 1; mkapp "$E/apps/Zed.app" 0 "$(printf '%040d' 77)" "$E/stock-build.json"; start_app "$E/apps/Zed.app"; sre_on
  "$D/deploy" run --first-swap >"$E/sig.out" 2>&1 & dp=$!
  poll 90 grep -q '\[first-swap\]' "$E/notify.log"; sleep 0.5; kill -TERM "$dp"; wait "$dp"; rc=$?; sre_off
  ck signal-first-swap-exit "$rc" 143; poll 20 test -n "$(port_up)"; ck signal-first-swap-stock-relaunched "$(port_up | wc -l | tr -d ' ')" 1
  ck signal-first-swap-hold "$([[ -e $E/home/hold ]] && echo y)" y; kill_dummy
  # C: during the health check of the new build: hold + urgent notice (new build stays installed)
  newenv sigC; install_prev; mkpr 1; beh '{"no_listen":true}'; start_app "$E/apps/CPZed.app"; sre_on
  "$D/deploy" run >"$E/sig.out" 2>&1 & dp=$!
  poll 90 eval '[[ "$(statej phase)" == health ]]'; sleep 0.3; kill -TERM "$dp"; wait "$dp"; rc=$?; sre_off
  ck signal-in-health-exit "$rc" 143; ck signal-in-health-hold "$([[ -e $E/home/hold ]] && echo y)" y; ckm signal-in-health-urgent "$(notes)" "The NEW build"
  ck signal-in-health-new-build-installed "$(sha_of "$E/apps/CPZed.app")" "$COMMIT"; kill_dummy
}


sc_signal_s1_s2() { # round 4: TERM during the quit wait; TERM during a slow swap exchange
  local dp rc
  # S1: the quit was sent, the app is exiting slowly, TERM lands in the wait: the old app is relaunched, hold + notice
  newenv sigS1; install_prev; mkpr 1; echo '{"slow_exit":4}' > "$E/slow.json"; mkapp "$E/apps/CPZed.app" 1 "$PREV_SHA" "$E/slow.json"; start_app "$E/apps/CPZed.app"; sre_on
  "$D/deploy" run >"$E/sig.out" 2>&1 & dp=$!
  poll 90 test -e "$E/quit.log"; sleep 1; kill -TERM "$dp"; wait "$dp"; rc=$?; sre_off
  ck signal-in-quit-wait-exit "$rc" 143; ck signal-in-quit-wait-hold "$([[ -e $E/home/hold ]] && echo y)" y; ckm signal-in-quit-wait-urgent "$(notes)" "after the quit was sent"
  poll 30 test -n "$(port_up)"; ck signal-in-quit-wait-editor-up "$(port_up | wc -l | tr -d ' ')" 1; ck signal-in-quit-wait-installed-untouched "$(sha_of "$E/apps/CPZed.app")" "$PREV_SHA"; kill_dummy
  # S2: TERM during a slow `swap exchange` (the swap completes, then the trap runs): the NEW build is named correctly
  newenv sigS2; install_prev; mkpr 1; cp -R "$D" "$E/scr5"; mv "$E/scr5/deploy-util" "$E/scr5/deploy-util.real"
  printf '%s\n' '#!/usr/bin/env python3' 'import subprocess, sys, os, time' \
    "rc = subprocess.call([sys.executable, '-I', os.path.dirname(os.path.abspath(__file__)) + '/deploy-util.real'] + sys.argv[1:])" \
    "if sys.argv[1:3] == ['swap', 'exchange']: time.sleep(3)" "sys.exit(rc)" > "$E/scr5/deploy-util"; chmod +x "$E/scr5/deploy-util"
  start_app "$E/apps/CPZed.app"; sre_on; "$E/scr5/deploy" run >"$E/sig.out" 2>&1 & dp=$!
  poll 90 eval '[[ "$(statej phase)" == swapping ]]'; sleep 1; kill -TERM "$dp"; wait "$dp"; rc=$?; sre_off
  ck signal-in-swap-exit "$rc" 143; ck signal-in-swap-installed-is-new "$(sha_of "$E/apps/CPZed.app")" "$COMMIT"
  ck signal-in-swap-hold "$([[ -e $E/home/hold ]] && echo y)" y; ckm signal-in-swap-names-the-new-build "$(notes)" "The NEW build"
  poll 30 test -n "$(port_up)"; ck signal-in-swap-editor-up "$(port_up | wc -l | tr -d ' ')" 1; kill_dummy
}

