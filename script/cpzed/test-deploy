MUTN=0
mutant() { # file old new  -> makes a mutant copy dir in M
  MUTN=$((MUTN + 1)); M=$T/mut$MUTN; mkdir -p "$M"; cp "$SRC"/* "$M"/ 2>/dev/null
  python3 -I - "$M/$1" "$2" "$3" <<'EOF' || return 1
import sys
p, old, new = sys.argv[1:]
s = open(p).read()
if s.count(old) < 1: sys.exit("mutation anchor not found in %s: %s" % (p, old))
open(p, "w").write(s.replace(old, new, 1))
EOF
}
mut() { # name file old new scenario [file old new]...
  local name=$1
  want "mut:$name" || return 0
  if ! mutant "$2" "$3" "$4"; then fail=$((fail+1)); echo "FAIL mut:$name: anchor missing"; return; fi
  local sc=$5; shift 5
  while [[ $# -ge 3 ]]; do
    python3 -I - "$M/$1" "$2" "$3" <<'PYEOF2' || { fail=$((fail+1)); echo "FAIL mut:$name: extra anchor missing"; return; }
import sys
p, old, new = sys.argv[1:]
s = open(p).read()
if old not in s: sys.exit(1)
open(p, "w").write(s.replace(old, new, 1))
PYEOF2
    shift 3
  done
  local save=$D; D=$M; QUIET=1; LAST_FAIL=0; "$sc" >/dev/null 2>&1; local lf=$LAST_FAIL; QUIET=0; D=$save
  pkill -9 -f "$T/" 2>/dev/null; pkill -f "$E/fake" 2>/dev/null; sre_off 2>/dev/null; kill_dummy 2>/dev/null
  LAST_FAIL=0; ck "mut: $name -> $sc fails without guard" "$lf" 1
}

run() { want "$1" || return 0; LAST_FAIL=0; "$1"; kill_dummy 2>/dev/null; pkill -f "$E/fake" 2>/dev/null; true; }

