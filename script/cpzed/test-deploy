sc_health_variants() {
  # keychain noise + a fake SecurityAgent: still healthy, and the notice says prompts are pending
  newenv hkey; install_prev; mkpr 1; beh '{"keychain":true}'; fake_tool FakeSecurityAgent 'sleep 60' >/dev/null
  start_app "$E/apps/CPZed.app"; sre_on; ( "$E/fake/FakeSecurityAgent/FakeSecurityAgent" & ) >/dev/null 2>&1; dep run; sre_off
  ck keychain-noise-passes "$RC" 0; ckm keychain-prompts-note "$(notes)" "prompts pending"
  ck keychain-no-rollback "$(sha_of "$E/apps/CPZed.app")" "$COMMIT"; pkill -f "$E/fake" 2>/dev/null
  # panic in the log -> rollback
  newenv hpanic; install_prev; mkpr 1; beh '{"panic":true}'; start_app "$E/apps/CPZed.app"; sre_on; dep run; sre_off
  ck panic-rolls-back "$RC" 20
  newenv hmig; install_prev; mkpr 1; beh '{"migration":true}'; start_app "$E/apps/CPZed.app"; sre_on; dep run; sre_off
  ck migration-error-rolls-back "$RC" 20
  # new build listens on no port -> rollback
  newenv hport; install_prev; mkpr 1; beh '{"no_listen":true}'; start_app "$E/apps/CPZed.app"; sre_on; dep run; sre_off
  ck no-port-rolls-back "$RC" 20
  # fewer terminal threads than before -> rollback
  newenv hthr; install_prev; mkpr 1; beh '{"drop_threads":true}'; echo '[{"id":1},{"id":2}]' > "$E/threads.json"; start_app "$E/apps/CPZed.app"; sre_on; dep run; sre_off
  ck fewer-threads-rolls-back "$RC" 20
  # wrong stamp (build json sha != deployed commit) -> aborted before the swap by bundle verification
  newenv hsha; install_prev; mkpr 1; cat > "$E/bin/bundle" <<'EOF'
#!/bin/sh
python3 -I "$CPZED_TEST_PREFIX/mkapp.py" "$CPZED_TEST_BUNDLE_OUT/CPZed.app" "$CPZED_TEST_N" "deadbeef" "$CPZED_TEST_PREFIX/next-build.json"
EOF
  start_app "$E/apps/CPZed.app"; sre_on; dep run; sre_off
  ck wrong-stamp-aborts-before-swap "$RC" 30; ck wrong-stamp-installed-untouched "$(sha_of "$E/apps/CPZed.app")" "$PREV_SHA"
}
sc_health_wrongsha() { # app reports a different sha than deployed: caught by health itself
  newenv hws; install_prev; mkpr 1; start_app "$E/apps/CPZed.app"; python3 -I "$E/mkapp.py" "$E/wrong/CPZed.app" 5 "$(printf '%040d' 5)" "$E/next-build.json"
  ln -s "$E/wrong/CPZed.app" "$E/wrongapp"
  OUT=$("$D/health" --app "$E/apps/CPZed.app" --n 1 --sha "$(printf '%040d' 12345)" --budget 1 2>&1); ck health-sha-mismatch "$?" 1; ckm health-sha-msg "$OUT" "cpzed-build.json sha"
  kill_dummy
}

