sc_n14_spaces() { # a bundle path with a SPACE is matched from the kernel's argv, not from ps text
  newenv n14; mkapp "$E/sp ace/CPZed.app" 1 "$PREV_SHA"
  ( cd "$E" && DUMMY_NO_LISTEN=1 DUMMY_PID_FILE="$E/sp.pid" nohup python3 -I "$E/sp ace/CPZed.app/Contents/MacOS/zed" >/dev/null 2>&1 & ); poll 20 test -s "$E/sp.pid"
  ck space-path-procs-of "$(python3 -I "$D/deploy-util" procs-of "$E/sp ace/CPZed.app/Contents/MacOS/zed" | grep -c .)" 1
  python3 -I "$D/deploy-util" same-exe "$(cat "$E/sp.pid")" "$E/sp ace/CPZed.app/Contents/MacOS/zed"; ck space-path-same-exe "$?" 0
  ck space-path-other-exe-not-matched "$(python3 -I "$D/deploy-util" procs-of "$E/other.app/Contents/MacOS/zed" | grep -c .)" 0
  kill -9 "$(cat "$E/sp.pid")" 2>/dev/null
  # a RELATIVE script path (started with ./zed from its own directory) is resolved against the process cwd
  ( cd "$E/sp ace/CPZed.app/Contents/MacOS" && DUMMY_NO_LISTEN=1 DUMMY_PID_FILE="$E/rel.pid" nohup python3 -I ./zed >/dev/null 2>&1 & ); poll 20 test -s "$E/rel.pid"
  ck relative-exec-path-resolved "$(python3 -I "$D/deploy-util" procs-of "$E/sp ace/CPZed.app/Contents/MacOS/zed" | grep -c .)" 1; kill -9 "$(cat "$E/rel.pid")" 2>/dev/null
  # --crash-handler is excluded only as the FIRST argument; anywhere else the process still counts as an instance
  ( cd "$E" && DUMMY_NO_LISTEN=1 DUMMY_PID_FILE="$E/ch.pid" nohup python3 -I "$E/sp ace/CPZed.app/Contents/MacOS/zed" foo --crash-handler >/dev/null 2>&1 & ); poll 20 test -s "$E/ch.pid"
  ck crash-handler-not-first-arg-still-counts "$(python3 -I "$D/deploy-util" procs-of "$E/sp ace/CPZed.app/Contents/MacOS/zed" | grep -c .)" 1; kill -9 "$(cat "$E/ch.pid")" 2>/dev/null
}

