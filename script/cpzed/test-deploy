}

sc_rollback_prev() { # new build fails health -> previous build back, re-stamped n+1
  newenv rbprev; install_prev; local BASE; BASE=$(git -C "$E/repo" rev-parse HEAD); mkapp "$E/apps/CPZed.app" 1 "$BASE"; mkstock; mkpr 1; beh '{"fail_agent_list":true}'
  echo '[{"id":1}]' > "$E/threads.json"; start_app "$E/apps/CPZed.app"; sre_on
  dep run; sre_off
  ck rollback-rc "$RC" 20
  ck rollback-prev-sha-back "$(sha_of "$E/apps/CPZed.app")" "$BASE"
  ck rollback-restamped-n-plus-1 "$(n_of "$E/apps/CPZed.app")" 3         # failed build was n=2
  ck rollback-version-string "$(/usr/libexec/PlistBuddy -c 'Print :CFBundleShortVersionString' "$E/apps/CPZed.app/Contents/Info.plist")" "1.0.0-cpzed.3"
  ck rollback-resigned "$([[ -f $E/apps/CPZed.app/Contents/Resources/signed-n ]] && echo y)" y
  ck rollback-app-running "$(port_up | wc -l | tr -d ' ')" 1
  ck rollback-next-n-advanced "$(statej n)" 4
  ckm rollback-notified "$(notes)" "rolled back to 3"
  ck rollback-no-hold "$([[ -e $E/home/hold ]] && echo y || echo n)" n
  ck rollback-sha-marked-bad "$(statej failed_sha)" "$COMMIT"
  dep run; ck rollback-bad-sha-not-retried "$RC" 10; ckm rollback-bad-sha-msg "$OUT" "failed before"
}
sc_rollback_stock() { # both fail -> stock
  newenv rbstock; install_prev; mkstock
  echo '{"fail_agent_list":true}' > "$E/prev-build.json"; mkapp "$E/apps/CPZed.app" 1 "$PREV_SHA" "$E/prev-build.json"
  mkpr 1; beh '{"fail_agent_list":true}'; echo '[{"id":1}]' > "$E/threads.json"; start_app "$E/apps/CPZed.app"; sre_on
  dep run; sre_off
