#!/usr/bin/env bash
# script/cpzed/test-deploy: tests for the CPZed deploy pipeline (CPZED-23).
#
# EVERYTHING runs in a throwaway prefix with a DUMMY app (a python process that listens on a port,
# can refuse to quit, fail its health check, write keychain noise, host fake cargo/claude children).
# Nothing here touches the real /Applications, ~/Library/Application Support/{Zed,CPZed}, or any real
# app: every path is overridden and CPZED_TEST_PREFIX makes deploy-lib refuse anything outside it.
# A before/after listing of the real locations is compared at the end.
#
# Every guard has a MUTATION test: the guard is removed in a temp copy of script/cpzed and the matching
# scenario must then FAIL ("mut: ... fails without guard"). Prints a pass/fail count; nonzero on failure.
#   test-deploy [-k pattern]    run only scenarios/mutations whose name matches
set -u
SRC="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
T=$(python3 -I -c 'import os,sys,tempfile;print(os.path.realpath(tempfile.mkdtemp(prefix="cpzed-test-deploy.")))')
PAT=""; [[ "${1:-}" == -k ]] && PAT=${2:-}
pass=0; fail=0; LAST_FAIL=0; QUIET=0; portn=0
cleanup() {
  trap '' INT TERM HUP
  local sig pids
  for sig in TERM KILL; do
    # everything that still has a file, cwd or lock fd under our temp dir (dummies, detached deploys, fake tools)
    pids=$(lsof -t +D "$T" 2>/dev/null | sort -u | grep -vx "$$" || true)
    [[ -n "$pids" ]] && kill -$sig $pids 2>/dev/null
    pkill -$sig -f "$T" 2>/dev/null
    sleep 0.3
  done
  python3 -I "$SRC/deploy-util" swap rm "$T" "$T" >/dev/null 2>&1; rm -rf "$T"
}
trap cleanup EXIT
trap 'exit 130' INT TERM HUP
D=$SRC            # script dir under test (mutants swap this)
ck() { # name got want
  if [[ "$2" == "$3" ]]; then ((QUIET)) || { pass=$((pass+1)); echo "ok   $1"; }
  else LAST_FAIL=1; ((QUIET)) || { fail=$((fail+1)); echo "FAIL $1: got '$2' want '$3'"; }; fi
}
ckm() { # name haystack needle
  if [[ "$2" == *"$3"* ]]; then ((QUIET)) || { pass=$((pass+1)); echo "ok   $1"; }
  else LAST_FAIL=1; ((QUIET)) || { fail=$((fail+1)); echo "FAIL $1: '$3' not in '${2:0:300}'"; }; fi
}
want() { [[ -z "$PAT" || "$1" == *$PAT* ]]; }

real_snapshot() { { ls -1 /Applications | grep -i zed; ls -1 "$HOME/Library/Application Support" | grep -i zed; ls -1 "$HOME/Library/Application Support/Zed" 2>/dev/null; ls -1 "$HOME/Library/Application Support/CPZed" 2>/dev/null; } | md5; }
REAL_BEFORE=$(real_snapshot)

# ------------------------------------------------------------- fixtures ----
newenv() { # name
  E=$T/$1; rm -rf "$E"; mkdir -p "$E"/{home,apps,data/db,data/threads,conf,bin,gh,fake}
  portn=$((portn + 1)); PORT=$((47100 + portn * 3 + $$ % 97 * 40))
  while lsof -nP -iTCP:"$PORT" -sTCP:LISTEN >/dev/null 2>&1; do PORT=$((PORT + 1)); done
  export CPZED_TEST_PREFIX=$E CPZED_HOME_DIR=$E/home CPZED_APP_DIR=$E/apps CPZED_DATA_DIR=$E/data CPZED_CONF_DIR=$E/conf
  export CPZED_PORT=$PORT CPZED_ZED_LOG=$E/Zed.log CPZED_REPO=$E/repo CPZED_LEDGER=$E/ledger.json
  export CPZED_QUIT_CMD="$E/bin/quit" CPZED_OPEN_CMD="$E/bin/open" CPZED_NOTIFY_CMD="$E/bin/notify"
  export CPZED_SIGN_CMD="$E/bin/sign" CPZED_VERIFY_CMD="$E/bin/verify" CPZED_SELFCHECK_CMD="$E/bin/selfcheck"
  export CPZED_LSREGISTER_CMD=/usr/bin/true CPZED_BUNDLE_CMD="$E/bin/bundle" CPZED_GH_CMD="$E/bin/gh"
  export CPZED_GATE_INTERVAL_S=0.5 CPZED_GATE_CPU_WINDOW_S=0.5 CPZED_PREQUIT_DELAY_S=0.5 CPZED_QUIT_WAIT_S=6
  export CPZED_HEALTH_ALIVE_S=0.5 CPZED_HEALTH_BUDGET_S=4 CPZED_HID_IDLE_CMD="/bin/echo 99999" CPZED_COALESCE_S=0
  export CPZED_FIRST_SWAP_WAIT_S=3 CPZED_DITTO_WAIT_S=10 CPZED_BUILD_RETRY_S=1 CPZED_MIN_INTERVAL_S=0
  export CPZED_PROMPT_PROCS="FakeSecurityAgent" CPZED_TEST_THREADS=$E/threads.json DUMMY_PID_FILE=$E/dummy.pid
  unset CPZED_NOTIFY_KIND
  echo '[]' > "$E/threads.json"; echo '{}' > "$E/next-build.json"
  cat > "$E/bin/quit" <<'EOF'
#!/bin/sh
echo "$(date +%s)" >> "$CPZED_TEST_PREFIX/quit.log"
[ -f "$CPZED_TEST_PREFIX/on-quit.sh" ] && sh "$CPZED_TEST_PREFIX/on-quit.sh"
pid=$(cat "$DUMMY_PID_FILE" 2>/dev/null); [ -n "$pid" ] && kill -TERM "$pid"; exit 0
EOF
  cat > "$E/bin/open" <<'EOF'
#!/bin/sh
echo "$(date +%s) $1" >> "$CPZED_TEST_PREFIX/open.log"
cd "$CPZED_TEST_PREFIX" && (nohup python3 -I "$1/Contents/MacOS/zed" >> "$CPZED_TEST_PREFIX/dummy.out" 2>&1 &) ; exit 0
EOF
  cat > "$E/bin/notify" <<'EOF'
#!/bin/sh
printf '%s\n' "[$CPZED_NOTIFY_KIND] $1" >> "$CPZED_TEST_PREFIX/notify.log"
EOF
  printf '#!/bin/sh\n[ ! -e "$1/Contents/BADSIG" ] && echo signed > "$1/Contents/Resources/signed-n"\n' > "$E/bin/sign"
  printf '#!/bin/sh\n[ ! -e "$1/Contents/BADSIG" ]\n' > "$E/bin/verify"
  printf '#!/bin/sh\n[ ! -e "$2/Contents/BADSELF" ]\n' > "$E/bin/selfcheck"
  cat > "$E/bin/bundle" <<'EOF'
#!/bin/sh
echo "bundle $CPZED_TEST_N" >> "$CPZED_TEST_PREFIX/bundle.log"
[ -e "$CPZED_TEST_PREFIX/bundle-exit" ] && exit "$(cat "$CPZED_TEST_PREFIX/bundle-exit")"
python3 -I "$CPZED_TEST_PREFIX/mkapp.py" "$CPZED_TEST_BUNDLE_OUT/CPZed.app" "$CPZED_TEST_N" "$CPZED_TEST_SHA" "$CPZED_TEST_PREFIX/next-build.json"
EOF
  cat > "$E/bin/gh" <<'EOF'
#!/bin/sh
echo "gh $*" >> "$CPZED_TEST_PREFIX/gh.log"
n=$(echo "$*" | sed -n 's/.*pr view \([0-9]*\).*/\1/p'); f="$CPZED_TEST_PREFIX/gh/pr-$n.json"
[ -f "$f" ] && cat "$f" || exit 1
EOF
  chmod +x "$E"/bin/*
  cat > "$E/dummy_zed.py" <<'EOF'
import json, os, signal, socket, subprocess, sys, time
if "--crash-handler" in sys.argv:          # Zed's helper: same exe, no instance
    while True: time.sleep(0.2)
here = os.path.dirname(os.path.abspath(__file__))
b = json.load(open(os.path.join(here, "..", "Resources", "dummy.json")))
port = int(os.environ["CPZED_PORT"]); log = os.environ.get("CPZED_ZED_LOG")
s = None
def slow(*a):
    try: s.close()
    except Exception: pass
    time.sleep(b.get("slow_exit", 0)); sys.exit(0)
if b.get("slow_exit"): signal.signal(signal.SIGTERM, slow)
elif b.get("refuse_quit"): signal.signal(signal.SIGTERM, signal.SIG_IGN)
else: signal.signal(signal.SIGTERM, lambda *a: sys.exit(0))

if os.environ.get("DUMMY_NO_LISTEN"): b["no_listen"] = True
if log and b.get("panic"): open(log, "a").write("thread 'main' panicked at src/x.rs:1:1: boom\n")
if log and b.get("keychain"): open(log, "a").write("ERROR errSecAuthFailed -25293 failed to read credentials\n")
if log and b.get("lsp_noise"): open(log, "a").write("LSP: handled a panic message gracefully\n")
if log and b.get("migration"): open(log, "a").write("Migration changed at index 3\n")
for c in b.get("children", []):
    subprocess.Popen(c["argv"], cwd=c.get("cwd") or None, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
if not b.get("no_listen"):
    s = socket.socket(); s.setsockopt(socket.SOL_SOCKET, socket.SO_REUSEADDR, 1)
    s.bind(("127.0.0.1", port)); s.listen(5)
open(os.environ["DUMMY_PID_FILE"], "w").write(str(os.getpid()))
if b.get("die_after"): time.sleep(b["die_after"]); sys.exit(1)
while True: time.sleep(0.2)
EOF
  cat > "$E/mkapp.py" <<'EOF'
import json, os, plistlib, shutil, sys
app, n, sha, beh = sys.argv[1:5]
shutil.rmtree(app, ignore_errors=True)
for d in ("Contents/MacOS", "Contents/Resources"): os.makedirs(os.path.join(app, d))
kind = "Zed" if app.endswith("Zed.app") and not app.endswith("CPZed.app") else "CPZed"
ver = "1.0.0-cpzed.%s" % n if kind == "CPZed" else "1.12.0"
plistlib.dump({"CFBundleIdentifier": "test.cpzed.dummy", "CFBundleShortVersionString": ver, "CFBundleVersion": sha[:7]},
              open(os.path.join(app, "Contents/Info.plist"), "wb"))
json.dump({"sha": sha, "n": int(n)}, open(os.path.join(app, "Contents/Resources/cpzed-build.json"), "w"))
try: b = json.load(open(beh))
except Exception: b = {}
json.dump(b, open(os.path.join(app, "Contents/Resources/dummy.json"), "w"))
here = os.path.dirname(os.path.abspath(beh))
shutil.copy(os.path.join(here, "dummy_zed.py"), os.path.join(app, "Contents/MacOS/zed"))
open(os.path.join(app, "Contents/MacOS/cli"), "w").write("""#!/bin/sh
d=$(cd "$(dirname "$0")/.." && pwd)
case "$1" in
 --version) echo "Zed $(/usr/libexec/PlistBuddy -c 'Print :CFBundleShortVersionString' "$d/Info.plist")";;
 --agent-list) grep -q fail_agent_list "$d/Resources/dummy.json" && { echo boom >&2; exit 1; }
   if grep -q drop_threads "$d/Resources/dummy.json"; then echo '[]'; else cat "$CPZED_TEST_THREADS"; fi;;
esac
""")
for f in ("zed", "cli"): os.chmod(os.path.join(app, "Contents/MacOS", f), 0o755)
EOF
  # git fixture: bare fork + clone with a `fork` remote; commit subjects carry (#N)
  git init -q --bare "$E/fork.git"; git init -q "$E/repo"
  ( cd "$E/repo" && git config user.email t@t && git config user.name t && git remote add fork "$E/fork.git" \
    && echo a > a && git add a && git commit -qm "base" && git branch -M main && git push -q fork main \
    && git init -q --bare "$E/up.git" && git remote add origin "$E/up.git" && git push -q origin main ) >/dev/null 2>&1
  echo '{"prs": []}' > "$E/ledger.json"
  PREV_SHA=$(git -C "$E/repo" rev-parse HEAD)
}
mkapp() { python3 -I "$E/mkapp.py" "$1" "$2" "$3" "${4:-$E/next-build.json}"; }
# commit "feat (#N)" on fork/main; sets COMMIT; ledger entry + gh stub per args
mkpr() { # n [reviewer] [tester] [hold] [approved] [state] [headmismatch]
  local n=$1 rv=${2:-clean} te=${3:-clean} ho=${4:-false} ap=${5:-true} st=${6:-MERGED} hm=${7:-}
  ( cd "$E/repo" && echo "$n" >> a && git commit -qam "feat $n (#$n)" && git push -q fork main ) >/dev/null 2>&1
  COMMIT=$(git -C "$E/repo" rev-parse HEAD)
  local head=$(printf '%040d' "$n")
  python3 -I - "$E/ledger.json" "$n" "$head" "$rv" "$te" "$ho" "$ap" <<'EOF'
import json, sys
p, n, head, rv, te, ho, ap = sys.argv[1:]
d = json.load(open(p)); d["prs"].append({"pr": int(n), "sha": head, "reviewer": rv, "tester": te, "hold": ho == "true", "user_approved": ap == "true"})
json.dump(d, open(p, "w"))
EOF
  printf '{"state":"%s","headRefOid":"%s","mergeCommit":{"oid":"%s"}}' "$st" "${hm:-$head}" "$COMMIT" > "$E/gh/pr-$n.json"
}
statej() { python3 -I "$D/deploy-util" state "$E/home/state.json" get "$1"; }
sets()   { python3 -I "$D/deploy-util" state "$E/home/state.json" set "$1" "$2"; }
setj()   { python3 -I "$D/deploy-util" state "$E/home/state.json" setj "$1" "$2"; }
sha_of() { python3 -I -c 'import json,sys;print(json.load(open(sys.argv[1]+"/Contents/Resources/cpzed-build.json"))["sha"])' "$1" 2>/dev/null; }
n_of()   { python3 -I -c 'import json,sys;print(json.load(open(sys.argv[1]+"/Contents/Resources/cpzed-build.json"))["n"])' "$1" 2>/dev/null; }
notes()  { cat "$E/notify.log" 2>/dev/null; }
# a fake sre: refresh quiescent_at until killed
sre_on()  { ( while :; do python3 -I "$D/deploy-util" state "$E/home/state.json" set quiescent_at "$(date +%s)" ; sleep 0.3; done ) >/dev/null 2>&1 & SRE=$!; }
SRE=
sre_off() { [[ -n "$SRE" ]] && { kill "$SRE" 2>/dev/null; wait "$SRE" 2>/dev/null; }; SRE=; return 0; }
dep() { # args -> RC, OUT   (runs `deploy run` in the foreground with a hard 60 s cap)
  OUT=$(perl -e '$SIG{ALRM}=sub{kill "TERM",-$$; exit 124}; setpgrp(0,0); alarm shift; system(@ARGV); exit($? >> 8)' "${DEP_T:-150}" "$D/deploy" "$@" 2>&1); RC=$?
}
poll() { # seconds cmd... : run cmd until it succeeds (bounded)
  local end=$(( $(date +%s) + $1 )); shift
  while ! "$@" >/dev/null 2>&1; do (( $(date +%s) >= end )) && return 1; sleep 0.2; done; return 0
}
gate_until() { # want_rc tries : refresh quiescent_at and run `gate check` until it returns want_rc (bounded); sets OUT, RC
  local want=$1 i
  for i in $(seq 1 ${2:-15}); do sets quiescent_at "$(date +%s)"; OUT=$("$D/gate" check 2>&1); RC=$?; [[ $RC == "$want" ]] && return 0; sleep 0.5; done; return 1
}
have_pid() { [[ -s "$E/dummy.pid" ]]; }
kill_dummy() { [[ -f "$E/dummy.pid" ]] && kill -9 "$(cat "$E/dummy.pid")" 2>/dev/null; pkill -9 -f "$E/" 2>/dev/null; sleep 0.2; rm -f "$E/dummy.pid"; }
start_app() { "$E/bin/open" "$1"; local i; for i in $(seq 1 40); do lsof -nP -iTCP:"$PORT" -sTCP:LISTEN -t >/dev/null 2>&1 && return 0; sleep 0.1; done; return 1; }
port_up() { lsof -nP -iTCP:"$PORT" -sTCP:LISTEN -t 2>/dev/null | head -1; }
# a prior healthy install n=1 + a stock archive; state n=2
install_prev() {
  mkapp "$E/apps/CPZed.app" 1 "$PREV_SHA" "$E/prev-build.json"
  sets n 2; sets deployed_sha ""
}
mkstock() {
  mkapp "$E/stockbuild/Zed.app" 0 "$(printf '%040d' 77)" "$E/stock-build.json"
  "$D/backup" stock-add "$E/stockbuild/Zed.app" >/dev/null
}
fake_tool() { # name body -> $E/fake/<name>/<name>
  mkdir -p "$E/fake/$1"; printf '#!/bin/sh\n%s\n' "$2" > "$E/fake/$1/$1"; chmod +x "$E/fake/$1/$1"; echo "$E/fake/$1/$1"
}
beh() { echo "$1" > "$E/next-build.json"; }

# --------------------------------------------------------------- scenarios -
sc_util_swap_probe() { newenv probe; ck swap-probe "$(python3 -I "$D/deploy-util" swap probe "$E")" atomic-swap-ok; }

sc_atomic_no_gap() { # a watcher polls the installed path while 300 exchanges happen: never missing
  newenv atomic; mkdir -p "$E/apps/.cpzed-stage"
  mkapp "$E/apps/CPZed.app" 1 "$(printf '%040d' 1)"; mkapp "$E/apps/.cpzed-stage/CPZed.app" 2 "$(printf '%040d' 2)"
  local misses
  misses=$(python3 -I - "$D" "$E/apps" "${1:-exchange}" <<'EOF'
import os, subprocess, sys, threading
D, apps, mode = sys.argv[1:4]
app, stage = apps + "/CPZed.app", apps + "/.cpzed-stage/CPZed.app"
stop, miss = False, 0
def watch():
    global miss
    while not stop:
        if not os.path.exists(app + "/Contents/Info.plist"): miss += 1
t = threading.Thread(target=watch); t.start()
for _ in range(300):
    if mode == "exchange":
        subprocess.run([sys.executable, "-I", D + "/deploy-util", "swap", "exchange", stage, app], check=True)
    else:   # the naive two-rename swap (what we must NEVER do)
        os.rename(app, apps + "/.cpzed-stage/tmp.app"); os.rename(stage, app); os.rename(apps + "/.cpzed-stage/tmp.app", stage)
stop = True; t.join(); print(miss)
EOF
)
  ck atomic-exchange-never-missing "$misses" 0
}
sc_naive_swap_has_gap() { sc_atomic_no_gap naive; }   # validates the watcher itself

rmu() { python3 -I "$D/deploy-util" swap rm "$1" "$2" "$E/home" "$E/apps"; }
sc_rm_guards() {
  newenv rm; mkdir -p "$E/home/ring/x" "$E/outside/y" "$E/home/tmp"; ln -s "$E/home/ring/x" "$E/home/ring/link"
  rmu "$E/outside/y" "$E/home/ring" 2>/dev/null; ck rm-outside-refused $? 1; ck rm-outside-kept "$([[ -d $E/outside/y ]] && echo y)" y
  rmu "$E/home/ring/link" "$E/home/ring" 2>/dev/null; ck rm-symlink-refused $? 1; ck rm-symlink-kept "$([[ -L $E/home/ring/link ]] && echo y)" y
  rmu "$E/home/ring" "$E/home/ring" 2>/dev/null; ck rm-root-itself-refused $? 1
  rmu "$E/home/ring/../../outside/y" "$E/home/ring" 2>/dev/null; ck rm-dotdot-refused $? 1
  mkdir -p "$E/home/misc/q"; rmu "$E/home/misc/q" "$E/home/misc" 2>/dev/null; ck rm-nonallowlisted-root-refused $? 1; ck rm-nonallowlisted-kept "$([[ -d $E/home/misc/q ]] && echo y)" y
  mkdir -p "$E/outside/ring/z"; rmu "$E/outside/ring/z" "$E/outside/ring" 2>/dev/null; ck rm-unanchored-root-refused $? 1; ck rm-unanchored-kept "$([[ -d $E/outside/ring/z ]] && echo y)" y
  rmu "$E/home/ring/x" "$E/home/ring" 2>/dev/null; ck rm-inside-ok "$([[ -d $E/home/ring/x ]] && echo present || echo gone)" gone
}

sc_detach() {
  newenv detach; install_prev; mkpr 1; start_app "$E/apps/CPZed.app"
  # a fake terminal: its own session; we HUP its whole process group after starting the deploy
  perl -MPOSIX -e 'POSIX::setsid(); exec @ARGV' bash -c "$D/deploy start >$E/start.out 2>&1; sleep 30" &
  local term=$!; poll 30 test -s "$E/home/deploy.pid"
  local pid; pid=$(cat "$E/home/deploy.pid" 2>/dev/null)
  ck detach-pidfile "$([[ -n $pid ]] && echo y)" y
  local psess pgid tty parent_pgid
  tty=$(ps -o tty= -p "$pid" | tr -d ' '); pgid=$(ps -o pgid= -p "$pid" | tr -d ' ')
  parent_pgid=$(ps -o pgid= -p "$term" | tr -d ' ')
  ck detach-no-tty "$tty" '??'
  ck detach-own-pgid "$([[ "$pgid" != "$parent_pgid" ]] && echo y)" y
  ck detach-own-session "$([[ "$(python3 -I -c 'import os,sys;print(os.getsid(int(sys.argv[1])))' "$pid")" != "$(python3 -I -c 'import os,sys;print(os.getsid(int(sys.argv[1])))' "$$")" ]] && echo y)" y
  kill -HUP -"$parent_pgid" 2>/dev/null; kill -HUP "$term" 2>/dev/null; sleep 1.5
  ck detach-survives-parent-hup "$(kill -0 "$pid" 2>/dev/null && echo alive)" alive
  kill "$pid" 2>/dev/null; sleep 0.5
}

sc_lock() {
  newenv lock; install_prev; mkpr 1; start_app "$E/apps/CPZed.app"; # no sre: the first deploy waits at the gate
  "$D/deploy" run >"$E/first.out" 2>&1 & local p1=$!; for _ in $(seq 1 200); do [[ -s $E/bundle.log ]] && break; sleep 0.1; done; sleep 1
  DEP_T=8 dep run; ck second-deploy-refused "$RC" 75; ckm second-deploy-msg "$OUT" "another deploy is running"
  ck second-deploy-built-nothing "$(grep -c bundle "$E/bundle.log" 2>/dev/null)" 1
  kill "$p1" 2>/dev/null; wait "$p1" 2>/dev/null; kill_dummy
  # stale lock (dead pid) is taken over
  echo 999999 > "$E/home/deploy.lock"; sets phase idle; sre_on; start_app "$E/apps/CPZed.app"; dep run; sre_off
  ck stale-lock-takeover "$RC" 0; kill_dummy
}

sc_hold() {
  newenv hold; install_prev; mkpr 1; echo "user hold" > "$E/home/hold"; dep run
  ck hold-rc "$RC" 78; ck hold-no-build "$(cat "$E/bundle.log" 2>/dev/null | wc -l | tr -d ' ')" 0
  ck hold-app-untouched "$(sha_of "$E/apps/CPZed.app")" "$PREV_SHA"
}

gate_env() { newenv "$1"; install_prev; start_app "$E/apps/CPZed.app" >/dev/null; }
sc_gate_cargo() {
  gate_env gcargo; kill_dummy
  local cargo; cargo=$(fake_tool cargo "sleep 60")
  beh "{\"children\":[{\"argv\":[\"$cargo\"]}]}"; mkapp "$E/apps/CPZed.app" 1 "$PREV_SHA"; start_app "$E/apps/CPZed.app"
  poll 20 pgrep -f "$E/fake/cargo/cargo"; gate_until 1; ck gate-busy-with-cargo "$RC" 1; ckm gate-names-cargo "$OUT" "build/test running"
  kill_dummy; pkill -f "$E/fake" 2>/dev/null
  beh '{}'; mkapp "$E/apps/CPZed.app" 1 "$PREV_SHA"; start_app "$E/apps/CPZed.app"; sets quiescent_at "$(date +%s)"
  gate_until 0; ck gate-quiet-without-cargo "$RC" 0; kill_dummy
}
sc_gate_stale() {
  gate_env gstale; sets quiescent_at "$(( $(date +%s) - 500 ))"
  OUT=$("$D/gate" check 2>&1); RC=$?; ck gate-stale-quiescent "$RC" 1; ckm gate-stale-msg "$OUT" "stale"
  python3 -I "$D/deploy-util" state "$E/home/state.json" del quiescent_at
  OUT=$("$D/gate" check 2>&1); ck gate-missing-quiescent "$?" 1
  sets quiescent_at "$(( $(date +%s) + 3000 ))"; OUT=$("$D/gate" check 2>&1); ck gate-future-quiescent "$?" 1
  kill_dummy
}
sc_gate_claude_cpu() {
  gate_env gcpu; kill_dummy
  local busy idle; busy=$(fake_tool claude 'while :; do :; done'); idle=$(fake_tool claudeidle 'sleep 60')
  mkdir -p "$E/fake/c"; cp "$idle" "$E/fake/c/claude"
  beh "{\"children\":[{\"argv\":[\"$busy\",\"--resume\",\"x\"]}]}"; mkapp "$E/apps/CPZed.app" 1 "$PREV_SHA"; start_app "$E/apps/CPZed.app"
  poll 20 pgrep -f "$E/fake/claude/claude"; CPZED_GATE_CPU_WINDOW_S=2 gate_until 1 20
  ck gate-busy-claude-blocks "$RC" 1; ckm gate-cpu-msg "$OUT" "CPU"; kill_dummy; pkill -9 -f "$E/fake" 2>/dev/null
  beh "{\"children\":[{\"argv\":[\"$E/fake/c/claude\"]}]}"; mkapp "$E/apps/CPZed.app" 1 "$PREV_SHA"; start_app "$E/apps/CPZed.app"
  poll 20 pgrep -f "$E/fake/c/claude"; gate_until 0; ck gate-idle-claude-passes "$RC" 0; kill_dummy; pkill -9 -f "$E/fake" 2>/dev/null
}
sc_gate_hid() {
  gate_env ghid; sets quiescent_at "$(date +%s)"; export CPZED_HID_IDLE_CMD="/bin/echo 30"
  OUT=$("$D/gate" check 2>&1); RC=$?; ck gate-user-active "$RC" 1; ckm gate-hid-msg "$OUT" "HID idle"; kill_dummy
}
sc_gate_hold_interval() {
  gate_env ghold; sets quiescent_at "$(date +%s)"; echo hold > "$E/home/hold"
  "$D/gate" check >/dev/null 2>&1; ck gate-hold-rc "$?" 2; rm "$E/home/hold"
  setj history "[{\"kind\":\"deploy\",\"n\":1,\"sha\":\"x\",\"at\":$(date +%s)}]"; export CPZED_MIN_INTERVAL_S=14400
  OUT=$("$D/gate" check 2>&1); ck gate-min-interval "$?" 1; ckm gate-interval-msg "$OUT" "minimum interval"
  export CPZED_MIN_INTERVAL_S=0; export CPZED_MAX_PER_DAY=1; OUT=$("$D/gate" check 2>&1); ck gate-daily-cap "$?" 1; ckm gate-cap-msg "$OUT" "daily cap"
  unset CPZED_MAX_PER_DAY; kill_dummy
}
sc_gate_notice() { # waits while busy, sends the (shortened) 4 h notice, never forces
  gate_env gnotice; export CPZED_GATE_NOTICE_S=1; sets quiescent_at 0
  OUT=$("$D/gate" wait --timeout 4 2>&1); RC=$?; unset CPZED_GATE_NOTICE_S
  ck gate-wait-timeout-rc "$RC" 3; ckm gate-4h-notice-sent "$(notes)" "[waiting] CPZed still waiting for quiet"
  ck gate-never-forced-app-alive "$(port_up | wc -l | tr -d ' ')" 1; kill_dummy
}

sc_eligible() {
  newenv elig; local out
  mkpr 1; out=$(python3 -I "$D/deploy-util" eligible "$E/repo" "$E/ledger.json" "$E/bin/gh" --quiet-s 0); ck elig-ok "$out" "$COMMIT"
  mkpr 2 dirty; out=$(python3 -I "$D/deploy-util" eligible "$E/repo" "$E/ledger.json" "$E/bin/gh" --quiet-s 0); ck elig-first-deploy-ships-only-up-to-the-approved-target "$out" "$(git -C "$E/repo" rev-parse HEAD~1)"
  newenv elig2; mkpr 1 clean dirty; out=$(python3 -I "$D/deploy-util" eligible "$E/repo" "$E/ledger.json" "$E/bin/gh" --quiet-s 0); ck elig-tester-not-clean "${out%%:*}" "blocked"
  newenv elig3; mkpr 1 clean clean true; out=$(python3 -I "$D/deploy-util" eligible "$E/repo" "$E/ledger.json" "$E/bin/gh" --quiet-s 0); ck elig-hold "${out%%:*}" "blocked"
  newenv elig4; mkpr 1 clean clean false false; out=$(python3 -I "$D/deploy-util" eligible "$E/repo" "$E/ledger.json" "$E/bin/gh" --quiet-s 0); ck elig-not-user-approved "${out%%:*}" "blocked"
  newenv elig5; mkpr 1 clean clean false true OPEN; out=$(python3 -I "$D/deploy-util" eligible "$E/repo" "$E/ledger.json" "$E/bin/gh" --quiet-s 0); ck elig-unmerged "${out%%:*}" "blocked"
  newenv elig6; mkpr 1 clean clean false true MERGED ffffffffffffffffffffffffffffffffffffffff; out=$(python3 -I "$D/deploy-util" eligible "$E/repo" "$E/ledger.json" "$E/bin/gh" --quiet-s 0); ck elig-head-sha-mismatch "${out%%:*}" "blocked"
  newenv elig7; ( cd "$E/repo" && echo z >> a && git commit -qam "direct push no PR" && git push -q fork main ) >/dev/null 2>&1
  out=$(python3 -I "$D/deploy-util" eligible "$E/repo" "$E/ledger.json" "$E/bin/gh" --quiet-s 0); ck elig-no-pr-in-subject "${out%%:*}" "blocked"
  newenv elig8; mkpr 1; local base=$COMMIT; ( cd "$E/repo" && echo z >> a && git commit -qam "sneaky direct push" && git push -q fork main ) >/dev/null 2>&1; mkpr 2
  out=$(python3 -I "$D/deploy-util" eligible "$E/repo" "$E/ledger.json" "$E/bin/gh" --deployed "$base" --quiet-s 0); ckm elig-chain-blocked-by-unapproved-commit "$out" "blocked by"
  newenv elig10; mkpr 1; ( cd "$E/repo" && echo z >> a && git commit -qam "feat nine (#9)" && git push -q fork main ) >/dev/null 2>&1
  out=$(python3 -I "$D/deploy-util" eligible "$E/repo" "$E/ledger.json" "$E/bin/gh" --deployed "$(git -C "$E/repo" rev-parse HEAD~1)" --quiet-s 0); ckm elig-pr-not-in-ledger "$out" "not in merge-ledger"
  newenv elig9; mkpr 1; out=$(python3 -I "$D/deploy-util" eligible "$E/repo" "$E/ledger.json" "$E/bin/gh" --quiet-s 99999); ckm elig-coalesce "$out" "coalescing"
  out=$(python3 -I "$D/deploy-util" eligible "$E/repo" "$E/ledger.json" "$E/bin/gh" --deployed "$COMMIT" --quiet-s 0); ckm elig-nothing-new "$out" "nothing new"
}

# the happy path; also the "never writes outside the prefix" and notification checks
sc_happy() {
  newenv happy; install_prev; mkstock; mkpr 1
  local claude; claude=$(fake_tool claude 'sleep 60')
  beh "{\"children\":[{\"argv\":[\"$claude\",\"--resume\",\"sess-abc\"],\"cwd\":\"$E/data\"},{\"argv\":[\"$claude\",\"--name\",\"my-name\"],\"cwd\":\"$E/conf\"},{\"argv\":[\"$claude\"],\"cwd\":\"$E\"}]}"
  mkapp "$E/apps/CPZed.app" 1 "$PREV_SHA" "$E/next-build.json"   # running prev has the children
  beh '{}'
  echo '[{"id":1},{"id":2}]' > "$E/threads.json"; echo "old log line" > "$E/Zed.log"
  start_app "$E/apps/CPZed.app"; local oldpid; oldpid=$(cat "$E/dummy.pid"); sre_on
  # watcher: the installed path must never be missing during the whole deploy
  python3 -I - "$E/apps/CPZed.app/Contents/Info.plist" "$E/watch.out" <<'EOF' &
import os, sys, time
p, out = sys.argv[1:3]; miss = 0; t0 = time.time()
while not os.path.exists(os.path.join(os.path.dirname(os.path.dirname(os.path.dirname(p))), ".stop")):
    if not os.path.exists(p): miss += 1
    if time.time() - t0 > 80: break
open(out, "w").write(str(miss))
EOF
  local wp=$!
  dep run; touch "$E/apps/.stop"; wait "$wp"; sre_off
  ck happy-rc "$RC" 0; [[ "$RC" == 0 ]] || echo "$OUT" | tail -5
  ck happy-new-sha "$(sha_of "$E/apps/CPZed.app")" "$COMMIT"
  ck happy-stamp-n "$(n_of "$E/apps/CPZed.app")" 2
  ck happy-installed-path-never-missing "$(cat "$E/watch.out")" 0
  ck happy-app-running-new "$(port_up | wc -l | tr -d ' ')" 1
  ck happy-old-process-exited "$(kill -0 "$oldpid" 2>/dev/null && echo alive || echo gone)" gone
  ck happy-old-bundle-removed "$([[ -e $E/apps/.cpzed-stage/CPZed.app ]] && echo left || echo gone)" gone
  ck happy-ring-has-zip "$(ls "$E/home/ring" | grep -c '^2-')" 1
  ck happy-cli-link "$(readlink "$E/home/zed-cli")" "$E/apps/CPZed.app/Contents/MacOS/cli"
  ck happy-state-deployed "$(statej deployed_sha)" "$COMMIT"; ck happy-state-phase "$(statej phase)" done
  ck happy-backup-made "$(ls "$E/home/backup" | wc -l | tr -d ' ')" 1
  ck happy-history-kind "$(python3 -I -c 'import json;print(json.load(open("'"$E"'/home/state.json"))["history"][-1]["kind"])')" deploy
  local nt; nt=$(notes)
  ckm note-ready "$nt" "[ready] CPZed 2/${COMMIT:0:7} ready, will restart when sessions are idle"
  ckm note-restarting "$nt" "[restarting] CPZed restarting"
  ckm note-restarting-lists-sessions "$nt" "$E/data"
  ckm note-running "$nt" "[running] CPZed 2 running"
  ckm resume-list-session-id "$nt" "cd $E/data && claude --resume sess-abc"
  ckm resume-list-name "$nt" "claude --resume my-name"
  ckm resume-list-continue "$nt" "claude --continue"
  ckm note-mbp "$nt" "MBP: CPZed 2 will arrive through Glider in about 10-20 min"
  ck happy-no-prompt-note "$([[ "$nt" == *"prompts pending"* ]] && echo yes || echo no)" no
  ck happy-threads-kept "$(python3 -I "$D/deploy-util" json-count "$E/threads.json")" 2
}

sc_refuse_quit() {
  newenv refuse; install_prev; mkpr 1; beh '{}'
  mkapp "$E/apps/CPZed.app" 1 "$PREV_SHA" "$E/refuser.json"; echo '{"refuse_quit":true}' > "$E/refuser.json"
  mkapp "$E/apps/CPZed.app" 1 "$PREV_SHA" "$E/refuser.json"
  start_app "$E/apps/CPZed.app"; local pid; pid=$(cat "$E/dummy.pid"); sre_on
  dep run; sre_off
  ck refuse-aborts "$RC" 30; ckm refuse-names-the-process "$(notes)" "MacOS/zed"; ck refuse-hold-set "$([[ -e $E/home/hold ]] && echo y)" y
  ck refuse-app-NOT-killed "$(kill -0 "$pid" 2>/dev/null && echo alive || echo dead)" alive
