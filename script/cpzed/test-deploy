sc_backup_which() {
  newenv bak; echo db > "$E/data/db/a"; echo th > "$E/data/threads/b"; echo cfg > "$E/conf/settings.json"
  local d; d=$("$D/backup" data); ck backup-db "$(cat "$d/db/a")" db; ck backup-threads "$(cat "$d/threads/b")" th; ck backup-config "$(cat "$d/config-zed/settings.json")" cfg
