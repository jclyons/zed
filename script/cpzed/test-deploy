sc_gate_recheck_after_ditto() { # B2b, marker-driven: the user returns as the archiver exits; the quit must wait for them
  newenv recheck; install_prev; mkpr 1
  printf '#!/bin/sh\necho call >> "$CPZED_TEST_PREFIX/hid.calls"\n[ -e "$CPZED_TEST_PREFIX/user-back" ] && echo 30 || echo 99999\n' > "$E/bin/hid"; chmod +x "$E/bin/hid"; export CPZED_HID_IDLE_CMD="$E/bin/hid"
  local d dp; d=$(fake_tool ditto "while [ ! -e $E/archiver.release ]; do sleep 0.2; done; touch $E/user-back; date +%s > $E/ditto.end")
  start_app "$E/apps/CPZed.app"; sre_on; touch "$E/hid.calls"
  ( "$d" -c -k --keepParent "$E/apps/CPZed.app" "$E/out.zip" >/dev/null 2>&1 & ); poll 20 pgrep -f "$E/fake/ditto/ditto"
  CPZED_DITTO_WAIT_S=120 "$D/deploy" run >"$E/dep.out" 2>&1 & dp=$!
  poll 90 grep -q '\[restarting\]' "$E/notify.log"
  local n0; n0=$(wc -l < "$E/hid.calls")
  poll 60 eval '[ "$(wc -l < "$E/hid.calls")" -gt "'"$n0"'" ]'          # the pre-quit gate check ran: the deploy is now in the archiver wait
  sleep 0.5; touch "$E/archiver.release"; poll 30 test -f "$E/ditto.end"
  sleep 6                                  # unguarded, the quit follows the archiver's exit at once
  ck recheck-no-quit-while-user-is-back "$([[ -e $E/quit.log ]] && echo quit || echo none)" none
  rm -f "$E/user-back"; date +%s > "$E/user-gone"; wait "$dp"; local rc=$?; sre_off
  ck recheck-deploy-ok "$rc" 0
  local q g; q=$(head -1 "$E/quit.log" 2>/dev/null); g=$(cat "$E/user-gone")
  ck recheck-quit-only-after-user-left "$([[ -n "$q" && "$q" -ge "$g" ]] && echo y)" y; kill_dummy
}

